{
  "$schema": "https://opencode.ai/tui.json",
  "theme": "onedark",
  "attention": {
    "enabled": true,
    "notifications": true,
    "sound": true
  },
  "keybinds": {
    "messages_half_page_up": "ctrl+u",
    "messages_half_page_down": "ctrl+d",
  },
  "plugin": [
    "opencode-traffic-light",
    "@slkiser/opencode-quota",
    "opencode-subagent-statusline"
  ]
}

