{
    "$schema": "https://opencode.ai/config.json",
    "share": "manual",
    "update": "auto",
    "compaction": {
        "auto": true
    },
    "permissions": [
        {
            "action": "*",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "external_directory",
            "resource": "*",
            "effect": "ask"
        },
        {
            "action": "external_directory",
            "resource": "/private/var/folders/**/opencode/**",
            "effect": "allow"
        },
        {
            "action": "external_directory",
            "resource": "/var/folders/**/opencode/**",
            "effect": "allow"
        },
        {
            "action": "external_directory",
            "resource": "/private/var/folders/hm/**",
            "effect": "allow"
        },
        {
            "action": "external_directory",
            "resource": "/var/folders/hm/**",
            "effect": "allow"
        },
        {
            "action": "external_directory",
            "resource": "~/.agents/**",
            "effect": "allow"
        },
        {
            "action": "external_directory",
            "resource": "~/.gradle/**",
            "effect": "allow"
        },
        {
            "action": "external_directory",
            "resource": "~/.plannotator/**",
            "effect": "allow"
        },
        {
            "action": "external_directory",
            "resource": "~/.querypie/**",
            "effect": "allow"
        },
        {
            "action": "external_directory",
            "resource": "~/github/**",
            "effect": "allow"
        },
        {
            "action": "external_directory",
            "resource": "~/Library/Application Support/rtk/**",
            "effect": "allow"
        },
        {
            "action": "external_directory",
            "resource": "~/.local/share/opencode/**",
            "effect": "allow"
        },
        // Include commands rewritten by the local RTK plugin.
        {
            "action": "shell",
            "resource": "*git push *--force*",
            "effect": "ask"
        },
        {
            "action": "shell",
            "resource": "*git push *-f*",
            "effect": "ask"
        },
        {
            "action": "shell",
            "resource": "*git reset *--hard*",
            "effect": "ask"
        },
        {
            "action": "shell",
            "resource": "*git reset *-h*",
            "effect": "ask"
        },
        {
            "action": "shell",
            "resource": "*rm -rf*",
            "effect": "ask"
        }
    ],
    "plugins": [
        "@tarquinen/opencode-dcp@latest",
        // Disabled for OpenCode v2 compatibility: still uses the v1 plugin API.
        // "@mohak34/opencode-notifier@latest",
        // "opencode-betterglob",
        // "opencode-bettergrep",
        {
            "package": "@plannotator/opencode@latest",
            "options": {
                "workflow": "manual"
            }
        },
        // Disabled for OpenCode v2 compatibility: v2 support is not confirmed.
        // "@slkiser/opencode-quota",
        // "@sunerpy/opencode-kiro-auth",
        "oh-my-opencode-slim",
    ],
    "default_agent": "orchestrator",
    "agents": {
        "solo": {
            "mode": "all",
            "description": "This agent is used only for handle task alone without subagent, or spawn solo agent profile only for subagent. This should not be spawned as subagent from agent which has other subagent profile than solo.",
            "system": "If subagent is not needed, prefer to do job only by yourself. And if using subagent, only spawn solo subagent profile only."
        },
        "explore": {
            "disabled": true
        },
        "general": {
            "disabled": true
        },
        "build": {
            "disabled": true
        },
        "plan": {
            "disabled": true
        },
    },
    "mcp": {
        "servers": {
            "deepwiki": {
                "type": "remote",
                "url": "https://mcp.deepwiki.com/mcp"
            },
            "grep": {
                "type": "remote",
                "url": "https://mcp.grep.app"
            }
        }
    },
    "providers": {
        "openai": {
            "models": {
                "gpt-6-astra": {
                    "limit": {
                        "context": 872000,
                        "output": 128000
                    }
                },
                "gpt-6-astra-fast": {
                    "limit": {
                        "context": 872000,
                        "output": 128000
                    }
                },
                "gpt-6.1-sol": {
                    "limit": {
                        "context": 872000,
                        "output": 128000
                    }
                },
                "gpt-6.1-sol-fast": {
                    "limit": {
                        "context": 872000,
                        "output": 128000
                    }
                },
                "gpt-6-luna": {
                    "limit": {
                        "context": 872000,
                        "output": 128000
                    }
                },
                "gpt-6-luna-fast": {
                    "limit": {
                        "context": 872000,
                        "output": 128000
                    }
                }
            }
        },
    }
    "warming": true
}
