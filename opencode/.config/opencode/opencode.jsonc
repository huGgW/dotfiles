{
    "$schema": "https://opencode.ai/config.json",
    "share": "manual",
    "update": "auto",
    "compaction": {
        "auto": true
    },
    "experimental": {
        "todo": true,
        "schedules": true,
    },
    "permissions": [
        {
            "action": "*",
            "resource": "*",
            "effect": "allow"
        },
        {
            "action": "external_directory",
            "resource": "*",
            "effect": "ask"
        },
        {
            "action": "external_directory",
            "resource": "/private/var/folders/**/opencode/**",
            "effect": "allow"
        },
        {
            "action": "external_directory",
            "resource": "/var/folders/**/opencode/**",
            "effect": "allow"
        },
        {
            "action": "external_directory",
            "resource": "/private/var/folders/hm/**",
            "effect": "allow"
        },
        {
            "action": "external_directory",
            "resource": "/var/folders/hm/**",
            "effect": "allow"
        },
        {
            "action": "external_directory",
            "resource": "~/.agents/**",
            "effect": "allow"
        },
        {
            "action": "external_directory",
            "resource": "~/.gradle/**",
            "effect": "allow"
        },
        {
            "action": "external_directory",
            "resource": "~/.plannotator/**",
            "effect": "allow"
        },
        {
            "action": "external_directory",
            "resource": "~/.querypie/**",
            "effect": "allow"
        },
        {
            "action": "external_directory",
            "resource": "~/github/**",
            "effect": "allow"
        },
        {
            "action": "external_directory",
            "resource": "~/Library/Application Support/rtk/**",
            "effect": "allow"
        },
        {
            "action": "external_directory",
            "resource": "~/.local/share/opencode/**",
            "effect": "allow"
        },
        // Include commands rewritten by the local RTK plugin.
        {
            "action": "shell",
            "resource": "*git push *--force*",
            "effect": "ask"
        },
        {
            "action": "shell",
            "resource": "*git push *-f*",
            "effect": "ask"
        },
        {
            "action": "shell",
            "resource": "*git reset *--hard*",
            "effect": "ask"
        },
        {
            "action": "shell",
            "resource": "*git reset *-h*",
            "effect": "ask"
        },
        {
            "action": "shell",
            "resource": "*rm -rf*",
            "effect": "ask"
        }
    ],
    "plugins": [
        "@tarquinen/opencode-dcp@latest",
        {
            "package": "@plannotator/opencode@latest",
            "options": {
                "workflow": "manual"
            }
        },
        "oh-my-opencode-slim",
        "@slkiser/opencode-quota",
        // Disabled for OpenCode v2 compatibility.
        // "@mohak34/opencode-notifier@latest",
        // "@sunerpy/opencode-kiro-auth",
    ],
    "default_agent": "orchestrator",
    "agents": {
        "solo": {
            "mode": "all",
            "description": "This agent is used only for handle task alone without subagent, or spawn solo agent profile only for subagent. This should not be spawned as subagent from agent which has other subagent profile than solo.",
            "system": "If subagent is not needed, prefer to do job only by yourself. And if using subagent, only spawn solo subagent profile only."
        },
        "explore": {
            "disabled": true
        },
        "general": {
            "disabled": true
        },
        "build": {
            "disabled": true
        },
        "plan": {
            "disabled": true
        },
    },
    "mcp": {
        "servers": {
            "deepwiki": {
                "type": "remote",
                "url": "https://mcp.deepwiki.com/mcp"
            },
            "grep": {
                "type": "remote",
                "url": "https://mcp.grep.app"
            "linear": {
                "type": "remote",
                "url": "https://mcp.linear.app/mcp"
            },
            "trail": {
                "type": "local",
                "command": [
                    "npx",
                    "-y",
                    "@trailhq/trail-code",
                    "mcp"
                ],
            }
        }
    },
    "warming": true,
}
