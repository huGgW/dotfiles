{
  "$schema": "https://raw.githubusercontent.com/Opencode-DCP/opencode-dynamic-context-pruning/master/dcp.schema.json",
  "enabled": true,
  "autoUpdate": true,
  "commands": {
    "enabled": true,
    "protectedTools": []
  },
  "manualMode":{
    "enabled": false,
    "automaticStrategies": true
  },
  "compress": {
    "maxContextLimit": "80%",
    "minContextLimit": "33%"
  },
  "experimental": {
    "allowSubAgents": true
  }
}
